{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://fokusfeed.dev/schemas/events/content.clustered.v1.schema.json",
    "title":  "content.clustered v1",
    "type":  "object",
    "additionalProperties":  false,
    "properties":  {
                       "event_id":  {
                                        "minLength":  1,
                                        "type":  "string"
                                    },
                       "event_type":  {
                                          "const":  "content.clustered"
                                      },
                       "event_version":  {
                                             "const":  "v1"
                                         },
                       "occurred_at":  {
                                           "type":  "string",
                                           "format":  "date-time"
                                       },
                       "producer":  {
                                        "minLength":  1,
                                        "type":  "string"
                                    },
                       "partition_key":  {
                                             "minLength":  1,
                                             "type":  "string"
                                         },
                       "dedupe_key":  {
                                          "minLength":  1,
                                          "type":  "string"
                                      },
                       "payload":  {
                                       "type":  "object",
                                       "additionalProperties":  true,
                                       "properties":  {
                                                          "cluster_id":  {
                                                                             "type":  "string"
                                                                         },
                                                          "content_ids":  {
                                                                              "items":  {
                                                                                            "type":  "string"
                                                                                        },
                                                                              "type":  "array"
                                                                          }
                                                      },
                                       "required":  [
                                                        "cluster_id",
                                                        "content_ids"
                                                    ]
                                   }
                   },
    "required":  [
                     "event_id",
                     "event_type",
                     "event_version",
                     "occurred_at",
                     "producer",
                     "partition_key",
                     "dedupe_key",
                     "payload"
                 ]
}
